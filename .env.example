# SQLite locally, PostgreSQL supported by the existing adapter
DATABASE_URL=file:./racecontrol.db
PAYLOAD_SECRET=replace-with-a-random-secret-of-at-least-48-characters
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
ACTIVE_SEASON=2026/2027
# Schema changes are explicit: stop servers/workers, then npm run db:push locally.
PAYLOAD_DB_PUSH=false

# preview (local only), resend or smtp. Production must use resend or smtp.
MAIL_MODE=preview
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Race Control <no-reply@your-verified-domain.example>
# Administrator bootstrap: set these in the terminal, not a committed file.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# Optional local seed admin password; never use shared demo credentials.
# SEED_ADMIN_PASSWORD=

# Production recovery endpoint (server-only; random unique value)
CRON_SECRET=
# Local-only mail previews (never use preview on Vercel)
MAIL_PREVIEW_DIR=work/mail
# Operator-only local production file may additionally contain OWNER_EMAIL and TEST_EMAIL.
